local canTrigger = true
local COMBOMAX_COOLDOWN = 0.3

local function GetKeyCode(str)
    str = string.upper(str)
    if str == "1" then return Enum.KeyCode.One
    elseif str == "2" then return Enum.KeyCode.Two
    elseif str == "3" then return Enum.KeyCode.Three
    elseif str == "4" then return Enum.KeyCode.Four
    end
    local success, keyCode = pcall(function() return Enum.KeyCode[str] end)
    if success then return keyCode end
    return nil
end

local function GetSlotFromCategory(cat)
    if cat == "Melee" then return "1"
    elseif cat == "Fruit" then return "2"
    elseif cat == "Sword" then return "3"
    elseif cat == "Gun" then return "4"
    end
    return "1"
end

local function ForceEquipToolByTip(category)
    local char = lp.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end

    local targetTip = category
    if category == "Fruit" then targetTip = "Blox Fruit" end

    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            if tool.ToolTip == targetTip or tool.Name:lower():find(category:lower()) then
                return tool
            end
        end
    end

    for _, tool in ipairs(lp.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == targetTip or tool.Name:lower():find(category:lower())) then
            hum:EquipTool(tool)
            return tool
        end
    end
    return nil
end

local function pressKey(keyCode)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

task.spawn(function()
    while true do
        if comboSignal then
            comboSignal = false
            
            if canTrigger and #comboQueue > 0 then
                canTrigger = false
                getgenv().Ahk_isComboActive = true 

                local lastCat = nil

                for index, item in ipairs(comboQueue) do
                    local cat = item.cat
                    local data = getgenv().Ahk_ActivatedSkills[cat][item.skill]
                    
                    if data and data.active == true and getgenv().Ahk_isComboActive then
                        
                        -- Attendre le délai de changement d'arme si l'arme change
                        if lastCat ~= nil and lastCat ~= cat then
                            local swDelay = math.clamp(item.switchDelay or 0.15, 0, 5)
                            if swDelay > 0 then
                                task.wait(swDelay)
                            end
                        end
                        lastCat = cat

                        if getgenv().Ahk_SelectedMod == "V2" then
                            ForceEquipToolByTip(cat)
                        else
                            local slotStr = GetSlotFromCategory(cat)
                            local toolKey = GetKeyCode(slotStr)
                            if toolKey then
                                pressKey(toolKey)
                            end
                        end
                        
                        if data.delay and data.delay > 0 then
                            task.wait(data.delay)
                        end
                        
                        local skill = item.skill
                        
                        if skill == "Tap" then
                            if mousemoveabs then
                                mousemoveabs(0, 0)
                            else
                                VirtualInputManager:SendMouseMoveEvent(0, 0, game)
                            end
                            
                            if data.hold and data.hold > 0 then
                                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                task.wait(data.hold)
                                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                            else
                                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                            end
                            StatusLbl.Text = "👆 [" .. index .. "] Tap exécuté"
                            StatusLbl.TextColor3 = C.green
                        else
                            local skillKey = GetKeyCode(skill)
                            if skillKey then
                                if data.hold and data.hold > 0 then
                                    VirtualInputManager:SendKeyEvent(true, skillKey, false, game)
                                    task.wait(data.hold)
                                    VirtualInputManager:SendKeyEvent(false, skillKey, false, game)
                                else
                                    VirtualInputManager:SendKeyEvent(true, skillKey, false, game)
                                    VirtualInputManager:SendKeyEvent(false, skillKey, false, game)
                                    VirtualInputManager:SendKeyEvent(true, skillKey, false, game)
                                    VirtualInputManager:SendKeyEvent(false, skillKey, false, game)
                                end
                                StatusLbl.Text = "🎯 [" .. index .. "] Skill envoyé : " .. skill
                                StatusLbl.TextColor3 = C.green
                            end
                        end
                        
                        RunService.Heartbeat:Wait()
                    end
                end
                
                task.wait(0.2) 
                getgenv().Ahk_isComboActive = false 
                StatusLbl.Text = "Remote Detection: ALWAYS ON"
                StatusLbl.TextColor3 = C.green

                isRunReady = true

                -- RELEASE MOUSE LOCK & ICON
                isMouseLockedToCorner = false
                if cornerMouseConn then cornerMouseConn:Disconnect(); cornerMouseConn = nil end
                UserInputService.MouseIconEnabled = true

                task.wait(COMBOMAX_COOLDOWN)
                canTrigger = true
            end
        end
        RunService.Heartbeat:Wait()
    end
end)

