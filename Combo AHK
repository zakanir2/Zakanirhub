local commERemote = ReplicatedStorage:WaitForChild("Remotes", 10) and ReplicatedStorage.Remotes:WaitForChild("CommE", 10)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    -- Détection des skills Z et V pour les conditions de pause
    if typeof(args[1]) == "string" then
        local skill = args[1]:upper()
        if skill == "Z" and currentTool then
            if currentTool.Name == "Shark Anchor" then sharkZActive = true end
            if currentTool.Name == "Cursed Dual Katana" then cursedZActive = true end
        elseif skill == "V" and lastTool == "Dough-Dough" then
            vActive = true
        end
    end

    -- REDIRECTION SILENT AIM UNIQUEMENT PENDANT LE COMBO
    if _G.SilentAimActive and _G.SilentAimTarget and getgenv().Ahk_isComboActive and not getgenv().Ahk_isVSkillPaused then
        local HookPosition = _G.SilentAimTarget.Position
        if HookPosition then
            -- Pour FireServer / InvokeServer avec des positions
            if method == "FireServer" and tostring(self) == "RemoteEvent" and tostring(args[1]) ~= "true" and tostring(args[1]) ~= "false" then
                args[1] = HookPosition
            elseif method == "InvokeServer" and self.Parent and tostring(self.Parent) == "Humanoid" and tostring(args[2]) ~= "true" and tostring(args[2]) ~= "false" and type(args[2]) == "vector" then
                args[2] = HookPosition
            end
        end
    end

    return oldNamecall(self, unpack(args))
end)
