    if touch.Position.X > cam.ViewportSize.X / 2 then
        rightTouchActive = true
        if isValidStopCondition() then pauseSA() end
    end
    
    if isMouseLockedToCorner then
        isMouseLockedToCorner = false
        if cornerMouseConn then cornerMouseConn:Disconnect() cornerMouseConn = nil end
        UserInputService.MouseIconEnabled = true
    end
end)

UserInputService.TouchEnded:Connect(function(touch)
    local cam = workspace.CurrentCamera
    if not cam then return end
    if touch.Position.X > cam.ViewportSize.X / 2 then
        rightTouchActive = false; restoreSA()
        sharkZActive, vActive, cursedZActive = false, false, false
    end
end)

