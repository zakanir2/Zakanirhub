local function RedrawQueueOrder()
    -- Nettoyage des anciennes lignes de switch visuelles
    for _, swRow in ipairs(switchRowsRegistry) do
        pcall(function() swRow:Destroy() end)
    end
    switchRowsRegistry = {}

    local layoutCounter = 0
    local prevCat = nil

    for index, item in ipairs(comboQueue) do
        -- Si l'arme change par rapport à la compétence précédente, insérer la ligne intermédiaire de Switch Delay
        if prevCat ~= nil and item.cat ~= prevCat then
            layoutCounter = layoutCounter + 1

            local swRow = mkFrame(QueueScroll, UDim2.new(1, -4, 0, 22), UDim2.new(0, 0, 0, 0), T_BG, 4)
            addStroke(swRow, Color3.fromRGB(240, 190, 70), 1, 0.6)
            swRow.LayoutOrder = layoutCounter

            local swLbl = mkLabel(swRow, UDim2.new(1, -65, 1, 0), UDim2.new(0, 8, 0, 0), "🔄 Switch Next Tool Delay", Enum.Font.GothamBold, 8, Color3.fromRGB(240, 190, 70), Enum.TextXAlignment.Left)

            local swBox = Instance.new("TextBox", swRow)
            swBox.Size = UDim2.new(0, 52, 1, -6)
            swBox.Position = UDim2.new(1, -56, 0, 3)
            swBox.BackgroundColor3 = T_CARD
            swBox.Text = tostring(item.switchDelay or 0.15) .. "s"
            swBox.PlaceholderText = "Switch"
            swBox.TextColor3 = Color3.fromRGB(240, 190, 70)
            swBox.Font = Enum.Font.GothamBold
            swBox.TextSize = 8
            Instance.new("UICorner", swBox).CornerRadius = UDim.new(0, 4)
            addStroke(swBox, Color3.fromRGB(240, 190, 70), 1, 0.7)

            swBox.FocusLost:Connect(function()
                local val = tonumber(swBox.Text:match("[%d%.]+")) or 0
                if val > 5 then val = 5 end
                if val < 0 then val = 0 end
                item.switchDelay = val
                swBox.Text = val .. "s"
            end)

            table.insert(switchRowsRegistry, swRow)
        end

        layoutCounter = layoutCounter + 1
        item.row.LayoutOrder = layoutCounter

        local orderLabel = item.row:FindFirstChild("OrderLabel")
        if orderLabel then
            local data = getgenv().Ahk_ActivatedSkills[item.cat][item.skill]
            orderLabel.Text = string.format("[%d] %s (%s) — D: %ss | H: %ss", index, item.cat, item.skill, tostring(data.delay), tostring(data.hold))
        end

        prevCat = item.cat
    end

    QueueScroll.CanvasSize = UDim2.new(0, 0, 0, uiList.AbsoluteContentSize.Y)
end

local function syncCheckboxUI(catName, keyName, state)
    local cb = checkboxRegistry[catName .. "_" .. keyName]
    if cb then
        local targetColor = state and T_ACCENT or C.toggleOff
        local targetPos = state and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
        TweenService:Create(cb.box, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()
        TweenService:Create(cb.dot, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {Position = targetPos}):Play()
    end
end

local function removeFromQueue(catName, keyName)
    for i, item in ipairs(comboQueue) do
        if item.cat == catName and item.skill == keyName then
            if item.row then item.row:Destroy() end
            table.remove(comboQueue, i)
            break
        end
    end
    RedrawQueueOrder()
end

local function addToQueue(catName, keyName)
    for _, item in ipairs(comboQueue) do
        if item.cat == catName and item.skill == keyName then return end
    end

    local qRow = mkFrame(QueueScroll, UDim2.new(1, -4, 0, 26), UDim2.new(0, 0, 0, 0), T_BG, 4)
